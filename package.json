{
  "name": "signage-app",
  "version": "1.3.0",
  "description": "디지털 사이니지 앱 - Electron + Next.js",
  "main": "dist/electron/main.js",
  "author": "Signage Team",
  "scripts": {
    "dev": "next dev",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.js",
    "build": "npm run build:next && npm run build:electron",
    "start": "next start",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && npm run build:electron && electron .\"",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run rebuild-native && npm run build && electron-builder",
    "dist:win": "npm run rebuild-native && npm run build && electron-builder --win",
    "dist:dir": "npm run rebuild-native && npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.20.5",
    "@tiptap/extension-font-family": "^3.20.5",
    "@tiptap/extension-text-align": "^3.20.5",
    "@tiptap/extension-text-style": "^3.20.5",
    "@tiptap/extension-underline": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.7.2",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.9",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.signage.smart-signage",
    "productName": "Smart Signage",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "dist/**/*",
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Signage"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
