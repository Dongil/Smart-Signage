{
  "name": "signage-app",
  "version": "1.0.0",
  "description": "디지털 사이니지 앱 - Electron + Next.js",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.electron.json",
    "start": "next start",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && tsc -p tsconfig.electron.json && electron .\""
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
